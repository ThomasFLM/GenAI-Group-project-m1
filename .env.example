# Copy this file to .env (ignored by git) and adapt it.
# Never commit an API key.

# --- Local LLM (Ollama) ---
LLM_BACKEND=ollama                 # ollama | anthropic | extractive (no LLM, for tests)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct   # lighter alternatives: llama3.2:3b, qwen2.5:3b-instruct
JUDGE_BACKEND=ollama               # model used as the judge in the evaluation
JUDGE_MODEL=qwen2.5:7b-instruct

# --- API (optional local vs API comparison) ---
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Retrieval ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # or BAAI/bge-m3 (heavier, better)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1   # or BAAI/bge-reranker-v2-m3
USE_RERANKER=1
TOP_K=5

# --- Corpus ---
# Official XML archive of the "Particuliers" fact sheets (dataset "Fiches pratiques et ressources de Service-Public.fr Particuliers" on data.gouv.fr)
CORPUS_URL=https://lecomarquage.service-public.fr/vdd/3.5/part/zip/vosdroits-latest.zip
