# Copier ce fichier en .env (ignoré par git) et adapter.
# Ne jamais commiter de clé d'API.

# --- LLM local (Ollama) ---
LLM_BACKEND=ollama                 # ollama | anthropic | extractive (sans LLM, pour tests)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct   # alternative plus légère : llama3.2:3b, qwen2.5:3b-instruct
JUDGE_BACKEND=ollama               # modèle utilisé comme juge dans l'évaluation
JUDGE_MODEL=qwen2.5:7b-instruct

# --- API (comparaison optionnelle local vs API) ---
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Retrieval ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # ou BAAI/bge-m3 (plus lourd, meilleur)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1   # ou BAAI/bge-reranker-v2-m3
USE_RERANKER=1
TOP_K=5

# --- Corpus ---
# Archive XML officielle des fiches Particuliers (jeu "Fiches pratiques et ressources de Service-Public.fr Particuliers" sur data.gouv.fr)
CORPUS_URL=https://lecomarquage.service-public.fr/vdd/3.4/part/zip/vosdroits-latest.zip
